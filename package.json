{
  "name": "banuakita",
  "version": "1.0.0",
  "description": "BanuaKita - Administrasi Desa Desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "@electron/rebuild": "^4.2.0"
  },
  "build": {
    "appId": "id.banuakita.app",
    "productName": "BanuaKita",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "database/**/*",
      "templates/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BanuaKita"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "better-sqlite3@11.10.0": true,
    "electron-winstaller@5.4.0": true
  }
}
