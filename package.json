{
  "name": "banuakita",
  "version": "1.0.0",
  "description": "Administrasi Desa Desktop",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "id.banuakita.app",
    "productName": "BanuaKita",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "database/**/*",
      "templates/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0"
  }
}
